generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  USD
  EUR
  GBP
  CAD
  JPY
}

enum AccountStatus {
  PENDING
  ACTIVE
  FROZEN
  CLOSED
}

enum AccountKind {
  CHECKING
  SAVINGS
  BUSINESS
}

enum TransferStatus {
  PENDING
  IN_REVIEW
  COMPLETED
  FAILED
  REVERSED
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum CardType {
  VIRTUAL
  PHYSICAL
}

enum CardStatus {
  INACTIVE
  ACTIVE
  FROZEN
  CANCELLED
}

enum FraudAction {
  ALLOW
  REVIEW
  BLOCK
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  WEBHOOK
}

enum StatementStatus {
  OPEN
  CLOSED
  DELIVERED
}

enum BeneficiaryStatus {
  PENDING_VERIFICATION
  VERIFIED
  BLOCKED
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

enum DisputeStatus {
  OPEN
  EVIDENCE_REQUIRED
  UNDER_REVIEW
  WON
  LOST
  WITHDRAWN
}

enum DisputeReason {
  UNAUTHORIZED
  DUPLICATE
  NOT_RECEIVED
  INCORRECT_AMOUNT
  OTHER
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum KycDocumentType {
  PASSPORT
  DRIVING_LICENSE
  NATIONAL_ID
  PROOF_OF_ADDRESS
}

enum KycStatus {
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum AuthorizationStatus {
  APPROVED
  DECLINED
  CAPTURED
  REVERSED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  fullName      String
  passwordHash  String
  kycVerified   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  accounts      Account[]
  invoices      Invoice[]
  notifications Notification[]
  apiKeys       ApiKey[]
  beneficiaries Beneficiary[]
  budgets       Budget[]
  disputes      Dispute[]
  webhooks      WebhookEndpoint[]
  kycDocuments  KycDocument[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Account {
  id           String        @id @default(uuid())
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id])
  name         String
  kind         AccountKind   @default(CHECKING)
  currency     Currency
  status       AccountStatus @default(PENDING)
  balanceMinor BigInt        @default(0)
  holdMinor    BigInt        @default(0)
  iban         String?       @unique
  closedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  outgoing Transfer[]    @relation("TransferSource")
  incoming Transfer[]    @relation("TransferDestination")
  entries  LedgerEntry[]
  cards    Card[]
  statements Statement[]

  @@index([ownerId])
  @@map("accounts")
}

model Transfer {
  id                   String         @id @default(uuid())
  idempotencyKey       String         @unique
  sourceAccountId      String
  destinationAccountId String
  source               Account        @relation("TransferSource", fields: [sourceAccountId], references: [id])
  destination          Account        @relation("TransferDestination", fields: [destinationAccountId], references: [id])
  amountMinor          BigInt
  currency             Currency
  memo                 String?
  status               TransferStatus @default(PENDING)
  createdAt            DateTime       @default(now())
  completedAt          DateTime?
  fraudCheck           FraudCheck?
  refunds              Refund[]
  disputes             Dispute[]

  @@index([sourceAccountId, createdAt])
  @@map("transfers")
}

model LedgerTransaction {
  id          String        @id @default(uuid())
  reference   String        @unique
  description String        @default("")
  createdAt   DateTime      @default(now())
  entries     LedgerEntry[]

  @@map("ledger_transactions")
}

model LedgerEntry {
  id                String            @id @default(uuid())
  transactionId     String
  transaction       LedgerTransaction @relation(fields: [transactionId], references: [id])
  accountId         String
  account           Account           @relation(fields: [accountId], references: [id])
  direction         EntryDirection
  amountMinor       BigInt
  currency          Currency
  balanceAfterMinor BigInt
  postedAt          DateTime          @default(now())

  @@index([accountId, postedAt])
  @@map("ledger_entries")
}

model Invoice {
  id            String        @id @default(uuid())
  number        String        @unique
  issuerId      String
  issuer        User          @relation(fields: [issuerId], references: [id])
  customerName  String
  customerEmail String
  currency      Currency
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime
  paidAt        DateTime?
  lines         InvoiceLine[]

  @@index([issuerId, status])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(uuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int
  unitPriceMinor BigInt

  @@map("invoice_lines")
}

model Card {
  id                  String     @id @default(uuid())
  accountId           String
  account             Account    @relation(fields: [accountId], references: [id])
  type                CardType
  status              CardStatus @default(INACTIVE)
  brand               String
  last4               String
  expMonth            Int
  expYear             Int
  monthlyLimitMinor   BigInt
  spentThisMonthMinor BigInt     @default(0)
  createdAt           DateTime   @default(now())
  authorizations      CardAuthorization[]

  @@index([accountId])
  @@map("cards")
}

model FraudCheck {
  id          String      @id @default(uuid())
  transferId  String      @unique
  transfer    Transfer    @relation(fields: [transferId], references: [id])
  score       Decimal     @db.Decimal(5, 4)
  action      FraudAction
  signals     Json
  evaluatedAt DateTime    @default(now())

  @@map("fraud_checks")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  template  String
  payload   Json
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  prefix     String    @unique
  hash       String
  label      String    @default("")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@map("api_keys")
}

model Statement {
  id                  String          @id @default(uuid())
  accountId           String
  account             Account         @relation(fields: [accountId], references: [id])
  periodStart         DateTime
  periodEnd           DateTime
  openingBalanceMinor BigInt
  closingBalanceMinor BigInt
  totalDebitsMinor    BigInt          @default(0)
  totalCreditsMinor   BigInt          @default(0)
  status              StatementStatus @default(OPEN)
  documentUrl         String?
  generatedAt         DateTime        @default(now())

  @@unique([accountId, periodStart, periodEnd])
  @@index([accountId, periodEnd])
  @@map("statements")
}

model Beneficiary {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  name        String
  iban        String
  bic         String?
  currency    Currency
  status      BeneficiaryStatus @default(PENDING_VERIFICATION)
  verifiedAt  DateTime?
  createdAt   DateTime          @default(now())

  @@unique([userId, iban])
  @@map("beneficiaries")
}

model Budget {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  name        String
  period      BudgetPeriod @default(MONTHLY)
  currency    Currency
  startsAt    DateTime
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  lines       BudgetLine[]

  @@index([userId, period])
  @@map("budgets")
}

model BudgetLine {
  id          String @id @default(uuid())
  budgetId    String
  budget      Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category    String
  limitMinor  BigInt
  spentMinor  BigInt @default(0)

  @@unique([budgetId, category])
  @@map("budget_lines")
}

model Dispute {
  id         String            @id @default(uuid())
  transferId String
  transfer   Transfer          @relation(fields: [transferId], references: [id])
  openedById String
  openedBy   User              @relation(fields: [openedById], references: [id])
  reason     DisputeReason
  status     DisputeStatus     @default(OPEN)
  details    String            @default("")
  openedAt   DateTime          @default(now())
  resolvedAt DateTime?
  evidence   DisputeEvidence[]

  @@index([transferId])
  @@index([openedById, status])
  @@map("disputes")
}

model DisputeEvidence {
  id          String   @id @default(uuid())
  disputeId   String
  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  description String
  fileUrl     String
  uploadedAt  DateTime @default(now())

  @@index([disputeId])
  @@map("dispute_evidence")
}

model Refund {
  id          String       @id @default(uuid())
  transferId  String
  transfer    Transfer     @relation(fields: [transferId], references: [id])
  amountMinor BigInt
  currency    Currency
  reason      String       @default("")
  status      RefundStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  settledAt   DateTime?

  @@index([transferId])
  @@map("refunds")
}

model WebhookEndpoint {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  url        String
  secret     String
  events     String[]
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@index([userId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id            String                @id @default(uuid())
  endpointId    String
  endpoint      WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  responseCode  Int?
  nextAttemptAt DateTime?
  createdAt     DateTime              @default(now())

  @@index([endpointId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model KycDocument {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id])
  type       KycDocumentType
  status     KycStatus       @default(SUBMITTED)
  storageKey String
  expiresAt  DateTime?
  reviewedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([userId, status])
  @@map("kyc_documents")
}

model ExchangeRate {
  id         String   @id @default(uuid())
  base       Currency
  quote      Currency
  rate       Decimal  @db.Decimal(18, 8)
  source     String   @default("ecb")
  observedAt DateTime

  @@unique([base, quote, observedAt])
  @@index([base, quote, observedAt])
  @@map("exchange_rates")
}

model CardAuthorization {
  id           String              @id @default(uuid())
  cardId       String
  card         Card                @relation(fields: [cardId], references: [id])
  merchant     String
  mcc          String
  amountMinor  BigInt
  currency     Currency
  status       AuthorizationStatus @default(APPROVED)
  declineCode  String?
  createdAt    DateTime            @default(now())

  @@index([cardId, createdAt])
  @@map("card_authorizations")
}
